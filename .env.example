# Only needed to re-probe live response shapes (`deno task probe`) or run the
# smoke test. Consumers of the SDK do not need a .env file.
CASHCTRL_DOMAINID=myorg
CASHCTRL_APIKEY=

# Disposable organisation for `deno task write-test`, which drives every write
# endpoint and must never point at real books. The write suite reads only these
# two variables, so it cannot resolve to the organisation above.
CASHCTRL_TEST_DOMAINID=
CASHCTRL_TEST_APIKEY=
